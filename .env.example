# Copy to .env for local capture. Never commit .env.
# SCREENSHOT_BASE_URL must be a credential-free origin (scheme + host[+port]).
# Replace the placeholders below with your running app origin.
# Do not commit a real machine IP or hostname.
# Docker capture: container localhost is not the host. For a port published
# on the host, use http://host.docker.internal:PORT.

SCREENSHOT_BASE_URL=http://HOST:PORT

# Optional metadata only. The capture tool records this value; it does not verify it.
# SCREENSHOT_APP_COMMIT_SHA=

# Optional overrides
# SCREENSHOT_CONFIG_DIR=config
# SCREENSHOT_OUTPUT_DIR=screenshot-output
# SCREENSHOT_NAVIGATION_TIMEOUT_MS=30000
# SCREENSHOT_READY_TIMEOUT_MS=15000
